مرحله ۳: بررسی نتایج
۳-۱: بررسی دیتابیس
powershell
docker exec -it bonyan-db psql -U bonyan -d bonyan_core -c "
SELECT 'customers' as table_name, COUNT(*) as count FROM customers
UNION ALL
SELECT 'projects', COUNT(*) FROM projects
UNION ALL
SELECT 'project_members', COUNT(*) FROM project_members
UNION ALL
SELECT 'contracts', COUNT(*) FROM contracts
UNION ALL
SELECT 'financial_obligations', COUNT(*) FROM financial_obligations
UNION ALL
SELECT 'financial_credits', COUNT(*) FROM financial_credits
UNION ALL
SELECT 'journal_entries', COUNT(*) FROM journal_entries
UNION ALL
SELECT 'receipts', COUNT(*) FROM receipts
ORDER BY count DESC;
"
